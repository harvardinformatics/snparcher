"""
snpArcher v2 — Postprocess Module

Filters a raw VCF to remove excluded individuals, non-callable sites,
small contigs, and low-quality variants.  Produces filtered, clean-SNP,
and clean-indel VCF files.

Can run standalone:
    snakemake --snakefile workflow/modules/postprocess/Snakefile \
        --configfile workflow/modules/postprocess/config/config.yaml \
        --config samples=... vcf=... ref_fai=... callable_sites_bed=...

Or imported by the main workflow via Snakemake's `module` directive
(config is passed in, overriding the configfile below).

Config keys (flat):
    samples             - path to samples CSV (required)
    sample_metadata     - path to metadata CSV (optional, for exclude column)
    vcf                 - path to raw VCF input (required)
    ref_fai             - path to reference .fai index (required)
    callable_sites_bed  - path to callable sites BED (required)
    contig_size         - contigs shorter than this are excluded (default 10000)
    maf                 - MAF filter threshold (default 0.01)
    missingness         - max missingness threshold (default 0.75)
    exclude_scaffolds   - comma-separated scaffolds to exclude (default "")
    long_contig_mode    - write CSI instead of TBI indexes (default false)
"""

import shlex

import pandas as pd

# ---------- Config / defaults ------------------------------------------------
# No configfile directive: it resolved against the working directory, so a
# standalone run failed outside a project, or silently read the project's main
# config. Pass --configfile (as run-postprocess.sh does) or --config; anything
# unset falls back to these defaults.

_PP_DEFAULTS = {
    "samples": "config/samples.csv",
    "sample_metadata": "",
    "vcf": "results/vcfs/raw.vcf.gz",
    "long_contig_mode": False,
    "ref_fai": "results/reference/ref.fa.gz.fai",
    "callable_sites_bed": "results/callable_sites/callable_sites.bed",
    "contig_size": 10000,
    "maf": 0.01,
    "missingness": 0.75,
    "exclude_scaffolds": "",
    "split_by_type": True,
    "keep_basic_filter": False,
}

for _k, _v in _PP_DEFAULTS.items():
    if _k not in config:
        config[_k] = _v


def _as_bool(value):
    """Coerce a config flag to bool, tolerating --config string values
    (e.g. split_by_type=false arrives as the truthy string "false")."""
    if isinstance(value, bool):
        return value
    if isinstance(value, (int, float)):
        return bool(value)
    return str(value).strip().lower() in {"true", "t", "yes", "y", "1"}


# Normalize boolean flags so both parent-supplied bools and standalone --config
# strings behave correctly.
config["split_by_type"] = _as_bool(config["split_by_type"])
config["keep_basic_filter"] = _as_bool(config["keep_basic_filter"])

config["long_contig_mode"] = _as_bool(config["long_contig_mode"])

_LONG_CONTIG_MODE = config["long_contig_mode"]
_BCFTOOLS_INDEX_ARGS = "-f -c" if _LONG_CONTIG_MODE else "-f -t"
_VCF_INDEX_SUFFIX = ".csi" if _LONG_CONTIG_MODE else ".tbi"


def _excluded_scaffolds():
    """exclude_scaffolds as a list, tolerating spaces and an empty or null value."""
    value = config["exclude_scaffolds"]
    return [name.strip() for name in str(value or "").split(",") if name.strip()]


def _vcf_index(vcf):
    return f"{vcf}{_VCF_INDEX_SUFFIX}"


def _maybe_temp(path):
    """Retain the basic-filter VCF only if the user opts in; else treat it as a
    temp intermediate consumed by strict_filter."""
    return path if config["keep_basic_filter"] else temp(path)


# ---------- Sample sheet + metadata ------------------------------------------

_SAMPLE_SHEET_DTYPES = {
    "sample_id": "string",
    "library_id": "string",
}

_SAMPLE_METADATA_DTYPES = {
    "sample_id": "string",
}


_samples_df = pd.read_csv(config["samples"], dtype=_SAMPLE_SHEET_DTYPES)
_ALL_SAMPLES = _samples_df["sample_id"].unique().tolist()

_metadata_df = None
_meta_path = config.get("sample_metadata", "")
if _meta_path:
    _metadata_df = pd.read_csv(_meta_path, dtype=_SAMPLE_METADATA_DTYPES)


def _parse_bool(series, col_name):
    """Tolerant boolean parser (matches common.smk logic)."""
    truthy = {"true", "t", "yes", "y", "1"}
    falsy  = {"false", "f", "no", "n", "0", ""}
    out = []
    for idx, v in series.items():
        if pd.isna(v):
            out.append(False)
        elif isinstance(v, bool):
            out.append(v)
        elif isinstance(v, (int, float)):
            out.append(bool(v))
        else:
            s = str(v).strip().lower()
            if s in truthy:
                out.append(True)
            elif s in falsy:
                out.append(False)
            else:
                raise ValueError(
                    f"Invalid {col_name} value at row {idx + 2}: {v!r}"
                )
    return pd.Series(out, index=series.index, dtype=bool)


if _metadata_df is not None and "exclude" in _metadata_df.columns:
    _metadata_df["exclude"] = _parse_bool(_metadata_df["exclude"], "exclude")


def _get_excluded_samples():
    if _metadata_df is None or "exclude" not in _metadata_df.columns:
        return []
    return _metadata_df.loc[_metadata_df["exclude"], "sample_id"].tolist()


def _get_included_samples():
    excluded = set(_get_excluded_samples())
    return [s for s in _ALL_SAMPLES if s not in excluded]


# ---------- rule all (standalone entry point) --------------------------------

rule all:
    input:
        "results/postprocess/filtered.vcf.gz",
        *(
            [
                "results/postprocess/clean_snps.vcf.gz",
                "results/postprocess/clean_indels.vcf.gz",
            ]
            if config["split_by_type"]
            else []
        ),


# ---------- Rules ------------------------------------------------------------

rule filter_individuals:
    """
    Write a list of samples to INCLUDE in downstream filtering.
    Samples with exclude=True in sample_metadata are removed.
    """
    output:
        include="results/postprocess/include_samples.txt",
    params:
        # As a param, the list reruns this rule whenever exclusions change.
        included=_get_included_samples(),
    run:
        with open(output.include, "w") as fh:
            for s in params.included:
                fh.write(s + "\n")


rule basic_filter:
    """
    Remove excluded individuals, sites failing filters, ref=N, alt=.,
    and sites with AF==0.
    """
    input:
        vcf=config["vcf"],
        include="results/postprocess/include_samples.txt",
    output:
        filtered=_maybe_temp("results/postprocess/basic.vcf.gz"),
        filtered_idx=_maybe_temp(_vcf_index("results/postprocess/basic.vcf.gz")),
    params:
        index_args=_BCFTOOLS_INDEX_ARGS,
    conda:
        "envs/filter.yml"
    log:
        "logs/postprocess/basic_filter.txt",
    shell:
        """
        # -a trims ALT alleles unseen in the kept samples, which can leave only
        # the spanning-deletion allele *: such a record carries no variant.
        # ALT="*" alone would match any record with a * allele, so require it
        # to be the only one.
        bcftools view -S {input.include} -f .,PASS {input.vcf} -a -U -O u 2> {log} \
            | bcftools +fill-tags -Ou 2>> {log} \
            | bcftools view -m2 -e 'AF==0 | ref="N" | ALT="." | (N_ALT=1 & ALT="*")' \
                -O z -o {output.filtered} 2>> {log}
        bcftools index {params.index_args} {output.filtered} 2>> {log}
        """


rule update_bed:
    """
    Refine callable-sites BED: remove contigs shorter than contig_size and the
    excluded scaffolds. Input and output BEDs both contain INCLUDE regions.
    strict_filter restricts the VCF to this BED, so the filtered VCF and BED
    agree on which contigs were dropped.
    """
    input:
        bed=config["callable_sites_bed"],
        fai=config["ref_fai"],
    output:
        bed="results/postprocess/callable_sites_filtered.bed",
        dropped_contigs=temp("results/postprocess/dropped_contigs.bed"),
    conda:
        "envs/bed.yml"
    params:
        size_filter=config["contig_size"],
        excluded=shlex.quote(",".join(_excluded_scaffolds())),
    log:
        "logs/postprocess/update_bed.txt",
    shell:
        """
        awk -v size={params.size_filter} -v excluded={params.excluded} \
            'BEGIN {{OFS = "\\t"; n = split(excluded, names, ","); for (i = 1; i <= n; i++) skip[names[i]] = 1}}
             $2 < size || ($1 in skip) {{print $1, 0, $2}}' \
            {input.fai} > {output.dropped_contigs} 2> {log}
        bedtools subtract -a {input.bed} -b {output.dropped_contigs} 2>> {log} \
            | bedtools sort -i - 2>> {log} \
            | bedtools merge -i - > {output.bed} 2>> {log}
        """


rule strict_filter:
    """
    Apply missingness and MAF filters, and restrict to the refined callable
    regions (which already exclude small contigs and excluded scaffolds).
    """
    input:
        bed="results/postprocess/callable_sites_filtered.bed",
        vcf="results/postprocess/basic.vcf.gz",
        basic_idx=_vcf_index("results/postprocess/basic.vcf.gz"),
    output:
        vcf="results/postprocess/filtered.vcf.gz",
        idx=_vcf_index("results/postprocess/filtered.vcf.gz"),
    conda:
        "envs/filter.yml"
    params:
        miss=config["missingness"],
        maf=config["maf"],
        upper_bound=lambda wildcards: 1 - float(config["maf"]),
        index_args=_BCFTOOLS_INDEX_ARGS,
    log:
        "logs/postprocess/strict_filter.txt",
    shell:
        """
        # -T keeps a record when its POS is callable. -R keeps any record whose
        # REF overlaps a callable region, admitting indels anchored at a
        # non-callable base; -T also streams instead of seeking per interval.
        bcftools view -T {input.bed} -m2 -M2 \
            -e 'F_MISSING > {params.miss} | AF<{params.maf} | AF>{params.upper_bound}' \
            {input.vcf} -O z -o {output.vcf} 2> {log}
        bcftools index {params.index_args} {output.vcf} 2>> {log}
        """


rule subset_indels:
    """Extract clean indels from strictly-filtered VCF."""
    input:
        vcf="results/postprocess/filtered.vcf.gz",
        idx=_vcf_index("results/postprocess/filtered.vcf.gz"),
    output:
        vcf="results/postprocess/clean_indels.vcf.gz",
        idx=_vcf_index("results/postprocess/clean_indels.vcf.gz"),
    params:
        index_args=_BCFTOOLS_INDEX_ARGS,
    conda:
        "envs/filter.yml"
    log:
        "logs/postprocess/subset_indels.txt"
    shell:
        """
        bcftools view -v indels -O z -o {output.vcf} {input.vcf} 2> {log}
        bcftools index {params.index_args} {output.vcf} 2>> {log}
        """


rule subset_snps:
    """Extract SNPs (excluding indel-overlapping sites) from strictly-filtered VCF."""
    input:
        vcf="results/postprocess/filtered.vcf.gz",
        idx=_vcf_index("results/postprocess/filtered.vcf.gz"),
    output:
        vcf=temp("results/postprocess/clean_snps_prefilter.vcf.gz"),
        idx=temp(_vcf_index("results/postprocess/clean_snps_prefilter.vcf.gz")),
    params:
        index_args=_BCFTOOLS_INDEX_ARGS,
    conda:
        "envs/filter.yml"
    log:
        "logs/postprocess/subset_snps.txt"
    shell:
        """
        bcftools view -v snps -e 'TYPE ~ "indel"' -O z -o {output.vcf} {input.vcf} 2> {log}
        bcftools index {params.index_args} {output.vcf} 2>> {log}
        """


rule drop_indel_SNPs:
    """Remove SNPs that overlap indels (genotype length > 1)."""
    input:
        vcf="results/postprocess/clean_snps_prefilter.vcf.gz",
        idx=_vcf_index("results/postprocess/clean_snps_prefilter.vcf.gz"),
    output:
        keep_snps=temp("results/postprocess/keep_snp_positions.txt"),
        vcf="results/postprocess/clean_snps.vcf.gz",
        idx=_vcf_index("results/postprocess/clean_snps.vcf.gz"),
    params:
        index_args=_BCFTOOLS_INDEX_ARGS,
    conda:
        "envs/filter.yml"
    log:
        "logs/postprocess/drop_indel_snps.txt"
    shell:
        """
        # A plain CHROM/POS targets file needs no bgzip or index, so nothing
        # is left behind beside the temp position list.
        bcftools query -f '%CHROM\t%POS\t%REF\t%ALT\n' {input.vcf} 2> {log} \
            | awk 'length($3) == 1 {{print $1"\t"$2}}' > {output.keep_snps}
        bcftools view -T {output.keep_snps} {input.vcf} -Oz -o {output.vcf} 2>> {log}
        bcftools index {params.index_args} {output.vcf} 2>> {log}
        """
